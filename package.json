{
  "name": "store-management",
  "version": "1.0.0",
  "description": "Professional Store Management Software with POS, Inventory, Billing & Reports",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "backup": "node scripts/backup.js",
    "test": "mocha tests/**/*.test.js --recursive --timeout 5000",
    "test:unit": "mocha tests/unit/*.test.js --recursive --timeout 5000",
    "test:integration": "mocha tests/integration/*.test.js --recursive --timeout 10000",
    "test:coverage": "nyc mocha tests/**/*.test.js --recursive --timeout 5000"
  },
  "keywords": [
    "pos",
    "inventory",
    "store-management",
    "billing",
    "retail"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.0.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsbarcode": "^3.11.6",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "chai": "^4.3.10",
    "mocha": "^10.2.0",
    "nodemon": "^3.0.2",
    "nyc": "^15.1.0",
    "supertest": "^6.3.3"
  }
}
