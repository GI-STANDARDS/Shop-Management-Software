<div class="page-header">
  <h1>Invoice</h1>
  <div class="page-actions no-print">
    <button class="btn btn-primary" onclick="window.print()">
      <svg data-lucide="printer" style="width:16px;height:16px"></svg>
      Print
    </button>
  </div>
</div>
<div id="invoiceDetail"><div class="loading-spinner"></div></div>
<script>
document.addEventListener('DOMContentLoaded', async () => {
  const id = window.location.pathname.match(/\/sales\/(\d+)/)?.[1];
  try {
    const s = await API.get('/sales/' + id);
    const settings = Store.get('settings') || {};
    document.getElementById('invoiceDetail').innerHTML = '<div class="invoice-card"><div class="invoice-header"><h2 style="font-size:var(--font-xl)">' + escapeHtml(settings.store_name || 'Store') + '</h2><p class="text-sm text-secondary">' + escapeHtml(settings.store_address || '') + '</p><p class="text-sm text-secondary">' + escapeHtml(settings.store_phone || '') + '</p><hr class="invoice-divider"><h3>Invoice: ' + escapeHtml(s.invoice_number) + '</h3><p class="text-sm text-secondary">' + formatDate(s.created_at) + '</p><p class="text-sm">Customer: ' + escapeHtml(s.customer_name || 'Walk-in') + '</p></div>' +
      '<table class="data-table"><thead><tr><th>Item</th><th>Qty</th><th>Price</th><th class="text-right">Total</th></tr></thead><tbody>' +
      (s.items || []).map(i => '<tr><td>' + escapeHtml(i.product_name) + '</td><td>' + i.quantity + '</td><td>' + formatCurrency(i.unit_price) + '</td><td class="text-right font-semibold">' + formatCurrency(i.total) + '</td></tr>').join('') +
      '</tbody></table><hr class="invoice-divider"><div class="text-right"><p>Subtotal: ' + formatCurrency(s.subtotal) + '</p><p>Tax: ' + formatCurrency(s.tax_total) + '</p><p style="font-size:var(--font-xl);font-weight:700">Total: ' + formatCurrency(s.grand_total) + '</p><p class="text-sm text-secondary">Paid: ' + formatCurrency(s.amount_paid) + ' | Change: ' + formatCurrency(s.change_amount) + '</p><p class="text-sm text-secondary">Method: ' + (s.payment_method || '-') + '</p></div><hr class="invoice-divider"><p class="text-center text-sm text-secondary">' + escapeHtml(settings.receipt_footer || 'Thank you for your business!') + '</p></div>';
  } catch(e) { showToast('Failed to load invoice', 'error'); }
});
</script>
