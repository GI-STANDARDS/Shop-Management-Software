<nav class="navbar">
  <div class="navbar-left">
    <button class="navbar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
      <svg data-lucide="panel-left-open"></svg>
    </button>
    <div class="navbar-datetime" id="navbarDatetime"></div>
  </div>
  <div class="navbar-right">
    <% if (user && user.role) { %>
    <span class="navbar-role-badge role-<%= user.role %>"><%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %></span>
    <% } %>
    <div class="navbar-search">
      <svg data-lucide="search"></svg>
      <input type="text" placeholder="Search..." id="globalSearch">
    </div>
    <button class="navbar-btn" onclick="Theme.toggle()" title="Toggle theme" aria-label="Toggle theme">
      <svg id="themeIcon" data-lucide="moon"></svg>
    </button>
    <button class="navbar-btn has-label" onclick="window.location.href='/app/pos'" title="Open POS (F1)">
      <svg data-lucide="shopping-cart"></svg>
      <span>POS</span>
    </button>
    <button class="navbar-btn" onclick="localStorage.removeItem('auth_token');localStorage.removeItem('user');document.cookie='auth_token=;path=/;max-age=0';window.location.href='/login'" title="Logout" aria-label="Logout">
      <svg data-lucide="log-out"></svg>
    </button>
  </div>
</nav>
